SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SESSION_SECRET=random_32byte_hex

# 마이그레이션 직접 실행용 (npm run db:apply -- supabase/xxx.sql).
# Dashboard → Project Settings → Database → Connection string → URI 복사.
# Supabase MCP가 끊겨도 이 경로로 .sql 적용 가능. 서버 전용(절대 노출 금지).
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# PostHog (선택) — 비워두면 트래킹 비활성. 설정 시 자동 수집 시작.
POSTHOG_KEY=phc_...
POSTHOG_HOST=https://us.i.posthog.com

# Web Push (PWA 알림) — 비워두면 푸시 비활성.
# VAPID_PUBLIC_KEY 는 클라이언트에 노출됨(공개키라 OK). PRIVATE 는 서버 전용.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@musicmatch.app

# Slack 알림 (선택) — 비워두면 알림 비활성(no-op).
# 새 가입/입금 신청이 들어오면 팀 채널로 알림이 간다 (src/lib/slack.server.ts).
# 설정법: Slack → Apps → "Incoming Webhooks" 추가 → 채널 선택 → 생성된 URL 복사 → 아래에 붙여넣기.
# 프로덕션 반영: Vercel → 프로젝트 → Settings → Environment Variables 에 Production 스코프로 추가 후 재배포.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# 관리자 승인 화면 키 (선택) — 설정 시 Slack 알림에 "✅ 승인하기" 링크(/admin?key=...&focus=...)가 첨부됨.
ADMIN_KEY=
# 알림 링크에 쓰는 서비스 도메인 (선택, 기본값 있음).
SITE_URL=https://music-dating-app-keonuu.vercel.app
