SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SESSION_SECRET=random_32byte_hex

# 마이그레이션 직접 실행용 (npm run db:apply -- supabase/xxx.sql).
# Dashboard → Project Settings → Database → Connection string → URI 복사.
# Supabase MCP가 끊겨도 이 경로로 .sql 적용 가능. 서버 전용(절대 노출 금지).
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# PostHog (선택) — 비워두면 트래킹 비활성. 설정 시 자동 수집 시작.
POSTHOG_KEY=phc_...
POSTHOG_HOST=https://us.i.posthog.com

# Amplitude (선택) — 브라우저용 공개 키. 미설정 시 코드 내 기본 키로 폴백(root.tsx).
# Autocapture + Session Replay(클라) + HTTP V2 서버 이벤트에 같은 키 사용.
# 키 확인: Amplitude → Settings → Projects → 해당 프로젝트 → API Key. (Secret Key 아님!)
# 키 유효성은 서버 부팅 로그 "[analytics.server] selftest" 로 확인 가능 (Railway Deploy Logs).
AMPLITUDE_API_KEY=
# 프로젝트가 EU 데이터센터면 EU 로 설정 (기본 US). 존이 다르면 이벤트가 조용히 유실된다.
AMPLITUDE_SERVER_ZONE=

# Google Analytics 4 (선택) — 비워두면 GA 비활성.
# GA4 측정 ID(G-XXXXXXXXXX): Google Analytics → 관리 → 데이터 스트림 → 웹 스트림에서 발급.
# 공개값이라 클라이언트(window.ENV) 노출 OK. 프로덕션 반영: Railway Variables 추가(자동 재배포).
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Web Push (PWA 알림) — 비워두면 푸시 비활성.
# VAPID_PUBLIC_KEY 는 클라이언트에 노출됨(공개키라 OK). PRIVATE 는 서버 전용.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@musicmatch.app

# Slack 알림 (선택) — 비워두면 알림 비활성(no-op).
# 새 가입/입금 신청이 들어오면 팀 채널로 알림이 간다 (src/lib/slack.server.ts).
# 설정법: Slack → Apps → "Incoming Webhooks" 추가 → 채널 선택 → 생성된 URL 복사 → 아래에 붙여넣기.
# 프로덕션 반영: Railway → 프로젝트 → 서비스 → Variables 에 추가 후 재배포.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# 관리자 승인 화면 키 (선택) — 설정 시 Slack 알림에 "✅ 승인하기" 링크(/admin?key=...&focus=...)가 첨부됨.
ADMIN_KEY=
# 알림 링크·OG 메타에 쓰는 서비스 도메인 (선택).
# 미설정 시 Railway가 자동 주입하는 RAILWAY_PUBLIC_DOMAIN 으로 폴백한다.
# 커스텀 도메인을 쓰면 여기에 명시(예: https://musicmatch.app).
SITE_URL=https://music-dating-app-keonuu.up.railway.app
